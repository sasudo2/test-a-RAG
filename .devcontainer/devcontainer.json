{
    "name": "test-a-RAG",
    "image": "test-a-rag-dev:local",
    "initializeCommand": "docker image inspect test-a-rag-dev:local >/dev/null 2>&1 || docker build -t test-a-rag-dev:local .",
    "customizations": {
        "vscode":{
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-azuretools.vscode-containers"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python"
            }
        }
    }
}